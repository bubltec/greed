# Local BFF (apps/bff) settings. Copy to .env; nothing here is a real secret.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=us-east-1
CONTENT_TABLE_NAME=greed-local-content
USERS_TABLE_NAME=greed-local-users
AUTH_TABLE_NAME=greed-local-auth
WEB_ORIGIN=http://localhost:5175
JWT_SECRET=local-dev-jwt-not-for-production
STAGE=local
# Comma-separated emails / GitHub logins allowed to edit. Local sign-in is always an editor.
EDITORS=john.josef@gmail.com
